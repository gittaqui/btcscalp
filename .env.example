# Never enable live trading before completing docs/RUNBOOK.md gates.
LIVE_TRADING_ENABLED=false
SANDBOX_TRADING_ENABLED=false
# Separate account-scoped keys, no withdrawal privileges.
# ENTRY key: require heartbeat enabled. GUARD key: require heartbeat disabled.
GEMINI_PROD_API_KEY=
GEMINI_PROD_API_SECRET=
GEMINI_PROD_GUARD_KEY=
GEMINI_PROD_GUARD_SECRET=
GEMINI_SANDBOX_API_KEY=
GEMINI_SANDBOX_API_SECRET=
GEMINI_SANDBOX_GUARD_KEY=
GEMINI_SANDBOX_GUARD_SECRET=
# Optional read-only fee lookup for paper; otherwise set actual fees in YAML.
DASHBOARD_TOKEN=
DISCORD_WEBHOOK_URL=
# Credentials for the sandbox tests only; tests never use production keys.
RUN_SANDBOX_TESTS=false
